<?xml version="1.0" encoding="utf-8"?>
<io.github.avalonskyafar.mallet.widget.MalletPage xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.avalonskyafar.mallet.widget.MalletHeading
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:malletDetail="@string/summary"
        app:malletHeadingLevel="page"
        app:malletTitle="@string/title" />

    <io.github.avalonskyafar.mallet.widget.MalletSurface
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp">

        <io.github.avalonskyafar.mallet.widget.MalletControlRow
            android:id="@+id/strength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:malletOptions="@array/levels"
            app:malletSelectedIndex="2"
            app:malletTitle="@string/strength" />

        <io.github.avalonskyafar.mallet.widget.MalletControlRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:malletDetail="@string/wifi_detail"
            app:malletTitle="@string/wifi">

            <io.github.avalonskyafar.mallet.widget.MalletSwitch
                android:id="@+id/wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:malletChecked="true" />
        </io.github.avalonskyafar.mallet.widget.MalletControlRow>

        <io.github.avalonskyafar.mallet.widget.MalletDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp" />

        <io.github.avalonskyafar.mallet.widget.MalletEntryRow
            android:id="@+id/exceptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:malletDetail="@string/exceptions_detail"
            app:malletEntryArrow="end"
            app:malletTitle="@string/exceptions" />

        <io.github.avalonskyafar.mallet.widget.MalletDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp" />

        <io.github.avalonskyafar.mallet.widget.MalletTextField
            android:id="@+id/profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="5dp"
            android:hint="@string/profile_hint"
            app:malletFieldCounter="24"
            app:malletFieldEndAction="clear"
            app:malletFieldLabel="@string/profile" />
    </io.github.avalonskyafar.mallet.widget.MalletSurface>

    <io.github.avalonskyafar.mallet.widget.MalletText
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:text="@string/status_idle"
        android:textAlignment="viewStart"
        app:malletTextRole="caption"
        app:malletTone="muted" />

    <io.github.avalonskyafar.mallet.widget.MalletButton
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="30dp"
        android:text="@string/save"
        app:malletButtonVariant="primary"
        app:malletIcon="check" />

    <io.github.avalonskyafar.mallet.widget.MalletButton
        android:id="@+id/restore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="30dp"
        android:text="@string/restore"
        app:malletButtonVariant="text" />
</io.github.avalonskyafar.mallet.widget.MalletPage>
