<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MalletHeading">
        <attr name="malletTitle" />
        <attr name="malletDetail" />
        <!-- Weight of the title: heading of a section (17 sp, default) or title of a page (20 sp). -->
        <attr name="malletHeadingLevel" format="enum">
            <enum name="section" value="0" />
            <enum name="page" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="MalletLinkRow">
        <attr name="android:enabled" />
        <!-- The label of the link. -->
        <attr name="malletTitle" />
        <!-- Colour role of the label and the chevron. Default: muted. -->
        <attr name="malletTone" />
        <!--
            Where the chevron sits: at the edge of the row, independent of the centred label
            (default), or right next to the label with the pair centred as a group.
        -->
        <attr name="malletLinkRowArrowPlacement" format="enum">
            <enum name="edge" value="0" />
            <enum name="adjacent" value="1" />
        </attr>
        <!-- The side the destination lies on, and so the side and direction of the chevron. Default: end. -->
        <attr name="malletLinkRowArrowDirection" format="enum">
            <enum name="start" value="0" />
            <enum name="end" value="1" />
        </attr>
    </declare-styleable>
</resources>
