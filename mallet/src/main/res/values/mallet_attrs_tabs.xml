<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MalletTabs">
        <!-- The tab labels, a string array. -->
        <attr name="malletOptions" />
        <attr name="malletSelectedIndex" />
        <!--
            How tabs share the width. "fill" gives every tab the same width. "scroll" gives every
            tab its natural width and scrolls the row, keeping the selected tab in view.
        -->
        <attr name="malletTabsLayout" format="enum">
            <enum name="fill" value="0" />
            <enum name="scroll" value="1" />
        </attr>
        <attr name="android:enabled" />
    </declare-styleable>
</resources>
