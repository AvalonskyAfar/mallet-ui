<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MalletCheckbox">
        <!-- Label at the end of the box. -->
        <attr name="android:text" />
        <attr name="android:enabled" />
        <!-- Whether the box starts checked. -->
        <attr name="malletChecked" />
        <!-- Hue that fills the checked box. Cobalt when absent. -->
        <attr name="malletHue" />
    </declare-styleable>
</resources>
