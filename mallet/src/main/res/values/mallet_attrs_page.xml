<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MalletPage">
        <!--
            Whether the page adds the system-bar, display-cutout and keyboard insets to its
            padding (default true). Switch it off inside a host that already handles insets.
        -->
        <attr name="malletPageFitSystemBars" format="boolean" />
        <!--
            The widest the column of the page gets (default 560dp); on a wider page it is
            centred. 0dp lets the column fill the page.
        -->
        <attr name="malletPageMaxContentWidth" format="dimension" />
    </declare-styleable>
</resources>
