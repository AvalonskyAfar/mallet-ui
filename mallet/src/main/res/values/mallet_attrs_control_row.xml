<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MalletControlRow">
        <attr name="malletTitle" />
        <attr name="malletDetail" />
        <!-- Options of the segmented track the row creates for itself. -->
        <attr name="malletOptions" />
        <attr name="malletSelectedIndex" />
        <!--
            How the width is shared between the text and a segmented track. "auto" follows the
            option count (two options 2 : 1, three 1 : 3, four or more 1 : 4); "utility" is
            always 1 : 1.35.
        -->
        <attr name="malletControlRowLayout" format="enum">
            <enum name="auto" value="0" />
            <enum name="utility" value="1" />
        </attr>
        <!-- Whether the title and the detail are centred in the text column or aligned to its start. -->
        <attr name="malletControlRowAlignment" format="enum">
            <enum name="center" value="0" />
            <enum name="start" value="1" />
        </attr>
        <!-- Weight of the text column next to a control declared as the XML child. -->
        <attr name="malletControlRowTextWeight" format="float" />
        <!--
            Weight of a control declared as the XML child. 0 (the default) keeps the control at
            its own width and gives the rest to the text.
        -->
        <attr name="malletControlRowControlWeight" format="float" />
        <attr name="android:enabled" />
    </declare-styleable>
</resources>
