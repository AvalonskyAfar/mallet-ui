<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MalletCallout">
        <!-- The title of the note, in the tone colour. -->
        <attr name="malletTitle" />
        <!-- The body of the note, in ink. -->
        <attr name="malletDetail" />
        <!-- Colour of the bar and the title: accent (default), danger, warning or success. -->
        <attr name="malletTone" />
    </declare-styleable>

    <declare-styleable name="MalletFlowRow">
        <!-- Titles of the steps, in order, as a string array. -->
        <attr name="malletFlowRowTitles" format="reference" />
        <!-- Details of the steps, as a string array parallel to the titles. May be shorter or absent. -->
        <attr name="malletFlowRowDetails" format="reference" />
    </declare-styleable>
</resources>
