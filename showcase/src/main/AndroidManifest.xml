<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptic ticks use View.performHapticFeedback and need no permission. The app asks for none. -->

    <!--
        The app keeps nothing worth backing up, so backup is off as a whole and no extraction
        rules are needed. The back callback takes effect from Android 13; older versions ignore
        the attribute.
    -->
    <application
        android:name=".ShowcaseApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="DataExtractionRules"
        tools:targetApi="33"
        android:icon="@mipmap/ic_showcase"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_showcase"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mallet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A second activity, opened and closed like a neighbouring page (MalletSpatialTransition). -->
        <activity
            android:name=".NeighbourActivity"
            android:exported="false" />
    </application>
</manifest>
