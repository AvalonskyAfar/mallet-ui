<?xml version="1.0" encoding="utf-8"?>
<!--
    The cards of the "Built from XML" page. Everything here is declared, not built in code;
    XmlPage.kt only finds the views by id and adds listeners.

    The part between the two "sample" markers is shown on the page as its own source.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical">

    <!-- sample:begin -->
    <io.github.avalonskyafar.mallet.widget.MalletHeading
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:malletDetail="@string/xml_filter_detail"
        app:malletTitle="@string/xml_filter_title" />

    <io.github.avalonskyafar.mallet.widget.MalletSurface
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <io.github.avalonskyafar.mallet.widget.MalletControlRow
            android:id="@+id/xml_strength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:malletOptions="@array/xml_levels"
            app:malletSelectedIndex="2"
            app:malletTitle="@string/xml_strength" />

        <io.github.avalonskyafar.mallet.widget.MalletControlRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:malletDetail="@string/xml_wifi_detail"
            app:malletTitle="@string/xml_wifi">

            <io.github.avalonskyafar.mallet.widget.MalletSwitch
                android:id="@+id/xml_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:malletChecked="true" />
        </io.github.avalonskyafar.mallet.widget.MalletControlRow>

        <io.github.avalonskyafar.mallet.widget.MalletDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp" />

        <io.github.avalonskyafar.mallet.widget.MalletEntryRow
            android:id="@+id/xml_exceptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:malletDetail="@string/xml_exceptions_detail"
            app:malletEntryArrow="end"
            app:malletTitle="@string/xml_exceptions" />
    </io.github.avalonskyafar.mallet.widget.MalletSurface>
    <!-- sample:end -->

    <io.github.avalonskyafar.mallet.widget.MalletHeading
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        app:malletDetail="@string/xml_profile_detail"
        app:malletTitle="@string/xml_profile_title" />

    <io.github.avalonskyafar.mallet.widget.MalletSurface
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:malletContentPadding="14dp">

        <io.github.avalonskyafar.mallet.widget.MalletTextField
            android:id="@+id/xml_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/xml_name_hint"
            app:malletFieldCounter="24"
            app:malletFieldEndAction="clear"
            app:malletFieldHelper="@string/xml_name_helper"
            app:malletFieldLabel="@string/xml_name" />

        <io.github.avalonskyafar.mallet.widget.MalletCheckbox
            android:id="@+id/xml_remember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/xml_remember"
            app:malletChecked="true"
            app:malletHue="jade" />
    </io.github.avalonskyafar.mallet.widget.MalletSurface>

    <io.github.avalonskyafar.mallet.widget.MalletText
        android:id="@+id/xml_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:text="@string/xml_status_idle"
        android:textAlignment="viewStart"
        app:malletTextRole="caption"
        app:malletTone="muted" />

    <io.github.avalonskyafar.mallet.widget.MalletButton
        android:id="@+id/xml_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="30dp"
        android:text="@string/xml_save"
        app:malletButtonVariant="primary"
        app:malletIcon="check" />
</LinearLayout>
