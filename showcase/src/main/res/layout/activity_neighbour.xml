<?xml version="1.0" encoding="utf-8"?>
<!--
    A whole screen declared in XML: the root is a MalletPage, which scrolls, sets the page
    rhythm and keeps clear of the system bars by itself. NeighbourActivity inflates this file
    and adds one click listener.
-->
<io.github.avalonskyafar.mallet.widget.MalletPage xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/neighbour_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.avalonskyafar.mallet.widget.MalletHeading
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:malletDetail="@string/neighbour_summary"
        app:malletHeadingLevel="page"
        app:malletTitle="@string/neighbour_title" />

    <io.github.avalonskyafar.mallet.widget.MalletParagraph
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="10dp"
        android:text="@string/neighbour_body" />

    <io.github.avalonskyafar.mallet.widget.MalletHeading
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        app:malletDetail="@string/neighbour_track_detail"
        app:malletTitle="@string/neighbour_track_title" />

    <io.github.avalonskyafar.mallet.widget.MalletSurface
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <io.github.avalonskyafar.mallet.widget.MalletSegmentedTrack
            android:id="@+id/neighbour_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:malletOptions="@array/neighbour_options"
            app:malletSelectedIndex="1" />
    </io.github.avalonskyafar.mallet.widget.MalletSurface>

    <io.github.avalonskyafar.mallet.widget.MalletButton
        android:id="@+id/neighbour_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="30dp"
        android:text="@string/neighbour_back" />
</io.github.avalonskyafar.mallet.widget.MalletPage>
