<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="material_porcelain_title">瓷面</string>
    <string name="material_porcelain_detail">卡片和胶囊的凸起主体：一圈细边，一道垂直落下的柔和阴影。</string>
    <string name="material_porcelain_card">一张卡片。细边、阴影，内边距 9 dp。</string>
    <string name="material_porcelain_flat">平面卡片。只留细边，不带阴影。</string>
    <string name="material_porcelain_lifted">同一张卡片，抬起之后。视图略微变大，好容下阴影。</string>
    <string name="material_porcelain_lift">抬起平面卡片</string>
    <string name="material_porcelain_flatten">放平</string>
    <string name="material_porcelain_glazed">上釉胶囊</string>
    <string name="material_porcelain_said">上釉的主体和素色主体一样下沉，颜色不变。</string>

    <string name="material_track_title">釉槽与滑块</string>
    <string name="material_track_detail">注满釉色的下沉轨道，和在轨道里滑动的素色滑块。</string>
    <string name="material_track_rest">静止</string>
    <string name="material_track_pressed">按下</string>
    <string name="material_track_rest_note">静止。釉槽和滑块下方的阴影都是完整长度。</string>
    <string name="material_track_pressed_note">按下。两道阴影一起收紧，颜色不变。</string>

    <string name="material_well_title">凹槽</string>
    <string name="material_well_detail">输入框和图片所在的凹陷处。聚焦或出错时，渐变边框换成纯色边框。</string>
    <string name="material_well_default">默认：边框上深下浅</string>
    <string name="material_well_focus">聚焦：墨色边框</string>
    <string name="material_well_error">出错：危险色边框</string>

    <string name="material_gutter_title">阴影画在视图之内</string>
    <string name="material_gutter_detail">主体把阴影画在自己的边界里，所以视图比看到的卡片略大一圈。虚线就是视图的边界。</string>
    <string name="material_gutter_actual">实际大小</string>
    <string name="material_gutter_magnified">放大四倍</string>
    <string name="material_gutter_actual_note">留边：两侧 1.4 dp，上方 1 dp，下方 4.8 dp。</string>
    <string name="material_gutter_magnified_note">底部一角，放大四倍。阴影在虚线之前就已消失。</string>

    <string name="material_split_title">分体卡片</string>
    <string name="material_split_detail">上下两半夹着一条分隔线，看起来是一张卡片，又可以各自移动或收起。</string>
    <string name="material_split_top">上半：只有上圆角，下方没有阴影。</string>
    <string name="material_split_bottom">下半：只有下圆角，承担整张卡片的阴影。</string>
    <string name="material_split_fold">收起下半</string>
    <string name="material_split_unfold">展开下半</string>

    <string name="material_origin">取自原应用：瓷面、釉槽与滑块、凹槽、阴影留边，以及首次启动页里的分体卡片。Sancai 新增：上釉的主胶囊、平面卡片，以及表示聚焦和出错的纯色凹槽边框。</string>
</resources>
