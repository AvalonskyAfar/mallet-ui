<resources>
    <string name="reveal_swipe_title">把一行拨到一边</string>
    <string name="reveal_swipe_detail" formatted="false">从起始侧把行拖开。露出超过操作区的 42 %，松手后保持打开；轻点这一行即可合上。开关仍由自己响应拖动。</string>
    <string name="reveal_rule_ads">拦截广告</string>
    <string name="reveal_rule_trackers">拦截跟踪器</string>
    <string name="reveal_rule_popups">拦截弹窗</string>
    <string name="reveal_rule_autoplay">禁止自动播放</string>
    <string name="reveal_delete">删除</string>
    <string name="reveal_removed">已删除“%1$s”</string>
    <string name="reveal_restore">恢复各行</string>
    <string name="reveal_restored">四行都已恢复</string>
    <string name="reveal_status">还剩 %1$d 行（共 4 行），其中 %2$d 行已开启</string>
    <string name="reveal_empty">已经没有行了，可在下方恢复。</string>

    <string name="reveal_end_title">操作在末端侧</string>
    <string name="reveal_end_detail">同样的行，设置 revealEdge = END，并换用强调色的操作。第二行由代码打开。</string>
    <string name="reveal_site_news">晨间新闻</string>
    <string name="reveal_site_video">视频网站</string>
    <string name="reveal_pin">置顶</string>
    <string name="reveal_pinned">已置顶“%1$s”</string>
    <string name="reveal_opened">“%1$s”已打开</string>

    <string name="reveal_expand_title">展开</string>
    <string name="reveal_expand_detail">轻点标题行。正文从上沿向下展开，箭头随之转动。</string>
    <string name="reveal_expand_status">已展开 %1$d 节，共 %2$d 节</string>
    <string name="reveal_topic_what">动的是什么</string>
    <string name="reveal_topic_what_body">变化的只有正文的高度。文字固定在上沿，下方被裁切，像一块盖板滑开。</string>
    <string name="reveal_topic_motion">中途改变主意</string>
    <string name="reveal_topic_motion_body">在移动途中再点一次，它会从当前位置折返。没有淡入淡出，也没有缩放。</string>
    <string name="reveal_topic_keys">不用触摸</string>
    <string name="reveal_topic_keys_body">焦点落在标题行时，按回车或空格即可展开或收起。读屏会读出当前是展开还是收起。</string>

    <string name="reveal_note">滑开一行露出“删除”取自原应用。末端侧的操作、操作的色调与图标，以及可展开的小节为 Mallet 新增。</string>
</resources>
