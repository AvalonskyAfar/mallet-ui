<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="numbers_stepper_title">步进器</string>
    <string name="numbers_stepper_detail">一步一步地调出精确的数。数值写在两个记号之间的滑块上。</string>
    <string name="numbers_stepper_delay">延迟</string>
    <string name="numbers_stepper_ratio">比例，每步 0.01</string>
    <string name="numbers_stepper_copies">份数，已到上限</string>
    <string name="numbers_stepper_idle">点记号加减，或点一下数值。</string>
    <string name="numbers_stepper_changed">%1$s已改为 %2$s</string>
    <string name="numbers_stepper_edit">%1$s：%2$s</string>
    <string name="numbers_stepper_note">按住记号可以连续加减，过一会儿会加快。到了上限或下限，那一侧的记号会变淡。点数值表示想直接输入：正式的应用会在这里弹出输入对话框，本页只把数值报出来。</string>

    <string name="numbers_slider_title">滑杆</string>
    <string name="numbers_slider_detail">拖动圆珠或点一下轨道，定一个大概的量。</string>
    <string name="numbers_slider_level">连续</string>
    <string name="numbers_slider_volume">分档，0 到 10</string>
    <string name="numbers_slider_strictness">沿釉色阶变化</string>
    <string-array name="numbers_slider_strictness_names">
        <item>关闭</item>
        <item>宽松</item>
        <item>标准</item>
        <item>严格</item>
    </string-array>

    <string name="numbers_progress_title">进度</string>
    <string name="numbers_progress_detail">一道凹槽，事情做了多少，釉色就填到哪里。</string>
    <string name="numbers_progress_follow">跟随上面的连续滑杆</string>
    <string name="numbers_progress_task">一项任务</string>
    <string name="numbers_progress_run">开始</string>
    <string name="numbers_progress_again">再来一次</string>
    <string name="numbers_progress_done">完成</string>
    <string name="numbers_progress_unknown">总量未知</string>
    <string name="numbers_progress_glazes">其他釉色，同一个滑杆</string>

    <string name="numbers_spinner_title">加载环</string>
    <string name="numbers_spinner_detail">等待很短、又无从计量的时候用。</string>
    <string name="numbers_spinner_sizes">大小</string>
    <string name="numbers_spinner_tones">色调</string>
    <string name="numbers_spinner_busy">正在保存</string>
    <string name="numbers_spinner_busy_detail">下面的按钮显示加载环，不响应点按。</string>
    <string name="numbers_spinner_save">保存</string>
    <string name="numbers_spinner_saved">已保存</string>

    <string name="numbers_origin">步进器取自原应用并加以补全：数值、范围和格式现在都由它自己管理。滑杆、进度条和加载环是为三彩新设计的，用的是同一种材质。</string>
</resources>
