<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="icons_all_title">全部五十个</string>
    <string name="icons_all_detail">画在 24 × 24 网格上的线条图标，全部由代码绘制。点一下，可以看到它的常量名。</string>

    <string name="icons_size_title">大小与粗细</string>
    <string name="icons_size_detail">图标会填满给它的方框。线宽与大小分开设置，所以大图标也可以保持纤细。</string>
    <string name="icons_size_label">大小</string>
    <string name="icons_stroke_label">线宽</string>
    <string name="icons_size_status">%1$s dp，线宽 %2$s dp</string>

    <string name="icons_tones_title">色调</string>
    <string name="icons_tones_detail">图标使用与文字相同的颜色角色，默认是淡色。点任意一个色调，上方的大图标随之变色。</string>
    <string name="icons_tone_status">tone = MalletTextTone.%1$s</string>

    <string name="icons_direction_title">方向</string>
    <string name="icons_direction_detail">朝左、朝右的折线箭头和箭头会跟随阅读方向翻转，夹在中间的对勾保持不变。</string>
    <string name="icons_ltr">从左到右</string>
    <string name="icons_rtl">从右到左</string>

    <string name="icons_origin">折线箭头、箭头、电源环、书本、滑杆和“更多”这六个图形取自原应用；其余四十四个图标，以及图标视图、色调和镜像翻转，都是为 Mallet 新做的。</string>
</resources>
