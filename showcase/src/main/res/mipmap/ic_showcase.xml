<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 8 there are no adaptive icons: the same mark on a white tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/showcase_icon_background" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_showcase_foreground" />
</layer-list>
