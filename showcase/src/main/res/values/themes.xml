<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The showcase lets the user pick light or dark regardless of the system, so the activity
        chooses one of these two before super.onCreate(). They only colour the window; every
        widget takes its colours from the SancaiTheme built by ShowcaseSettings.
    -->
    <style name="Theme.Showcase.Light" parent="Theme.Sancai.Light" />

    <style name="Theme.Showcase.Dark" parent="Theme.Sancai.Dark" />
</resources>
