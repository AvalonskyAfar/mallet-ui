<resources>
    <string name="numbers_stepper_title">Stepper</string>
    <string name="numbers_stepper_detail">An exact number, one step at a time. The value sits on the thumb between the two marks.</string>
    <string name="numbers_stepper_delay">Delay</string>
    <string name="numbers_stepper_ratio">Ratio, in steps of 0.01</string>
    <string name="numbers_stepper_copies">Copies, at the upper bound</string>
    <string name="numbers_stepper_idle">Tap a mark to step, or tap the value.</string>
    <string name="numbers_stepper_changed">%1$s is now %2$s</string>
    <string name="numbers_stepper_edit">%1$s: %2$s</string>
    <string name="numbers_stepper_note">Hold a mark to repeat; the pace picks up after a moment. At a bound the mark on that side pales. Tapping the value asks for editing. An app would open an input dialog here; this page only says the value.</string>

