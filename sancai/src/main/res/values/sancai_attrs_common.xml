<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Attributes shared by several widgets. They are declared here once, with their format;
        widget styleables refer to them by name only.
    -->

    <!--
        What every control built on SancaiControl reads from a layout besides its own
        attributes: it is focusable and clickable unless the layout says otherwise.
    -->
    <declare-styleable name="SancaiControl">
        <attr name="android:focusable" />
        <attr name="android:clickable" />
    </declare-styleable>

    <!-- One of the five glazes of the theme. -->
    <attr name="sancaiGlaze" format="enum">
        <enum name="terracotta" value="0" />
        <enum name="ochre" value="1" />
        <enum name="cobalt" value="2" />
        <enum name="celadon" value="3" />
        <enum name="mist" value="4" />
    </attr>

    <!-- Colour role of text or of an icon. -->
    <attr name="sancaiTone" format="enum">
        <enum name="ink" value="0" />
        <enum name="muted" value="1" />
        <enum name="accent" value="2" />
        <enum name="danger" value="3" />
        <enum name="warning" value="4" />
        <enum name="success" value="5" />
    </attr>

    <!-- Role in the type scale. -->
    <attr name="sancaiTextRole" format="enum">
        <enum name="display" value="0" />
        <enum name="title" value="1" />
        <enum name="headline" value="2" />
        <enum name="heading" value="3" />
        <enum name="subhead" value="4" />
        <enum name="body" value="5" />
        <enum name="bodyCompact" value="6" />
        <enum name="label" value="7" />
        <enum name="footnote" value="8" />
        <enum name="caption" value="9" />
        <enum name="micro" value="10" />
    </attr>

    <!-- Main line of a row, heading or state view. -->
    <attr name="sancaiTitle" format="string" />
    <!-- Supporting line under the title. -->
    <attr name="sancaiDetail" format="string" />
    <!-- Whether a two-state control starts checked. -->
    <attr name="sancaiChecked" format="boolean" />
    <!-- Options of a multi-option control, as a string array. -->
    <attr name="sancaiOptions" format="reference" />
    <!-- Index of the option selected at start. -->
    <attr name="sancaiSelectedIndex" format="integer" />
    <!-- Corner radius of a body. -->
    <attr name="sancaiCornerRadius" format="dimension" />
    <!-- Whether a body is lifted (rim and shadow) or flat (rim only). -->
    <attr name="sancaiElevated" format="boolean" />
    <!-- Lower bound of a numeric control. -->
    <attr name="sancaiValueFrom" format="float" />
    <!-- Upper bound of a numeric control. -->
    <attr name="sancaiValueTo" format="float" />
    <!-- The step a numeric control moves in. -->
    <attr name="sancaiStepSize" format="float" />
    <!-- The value a numeric control starts with. -->
    <attr name="sancaiValue" format="float" />

    <!-- An icon of the built-in set. Values follow the order of the SancaiIcon enum. -->
    <attr name="sancaiIcon" format="enum">
        <enum name="none" value="-1" />
        <enum name="chevron_left" value="0" />
        <enum name="chevron_right" value="1" />
        <enum name="chevron_up" value="2" />
        <enum name="chevron_down" value="3" />
        <enum name="arrow_left" value="4" />
        <enum name="arrow_right" value="5" />
        <enum name="arrow_up" value="6" />
        <enum name="arrow_down" value="7" />
        <enum name="check" value="8" />
        <enum name="close" value="9" />
        <enum name="plus" value="10" />
        <enum name="minus" value="11" />
        <enum name="search" value="12" />
        <enum name="more_horizontal" value="13" />
        <enum name="more_vertical" value="14" />
        <enum name="menu" value="15" />
        <enum name="power" value="16" />
        <enum name="book" value="17" />
        <enum name="sliders" value="18" />
        <enum name="more_circle" value="19" />
        <enum name="info" value="20" />
        <enum name="warning" value="21" />
        <enum name="error" value="22" />
        <enum name="success" value="23" />
        <enum name="trash" value="24" />
        <enum name="edit" value="25" />
        <enum name="copy" value="26" />
        <enum name="share" value="27" />
        <enum name="download" value="28" />
        <enum name="refresh" value="29" />
        <enum name="eye" value="30" />
        <enum name="eye_off" value="31" />
        <enum name="lock" value="32" />
        <enum name="bell" value="33" />
        <enum name="star" value="34" />
        <enum name="heart" value="35" />
        <enum name="home" value="36" />
        <enum name="user" value="37" />
        <enum name="sun" value="38" />
        <enum name="moon" value="39" />
        <enum name="layers" value="40" />
        <enum name="grid" value="41" />
        <enum name="list" value="42" />
        <enum name="image" value="43" />
        <enum name="inbox" value="44" />
        <enum name="cloud_off" value="45" />
        <enum name="clock" value="46" />
        <enum name="shield" value="47" />
        <enum name="hand" value="48" />
        <enum name="palette" value="49" />
    </attr>
</resources>
