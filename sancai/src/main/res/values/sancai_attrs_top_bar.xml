<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SancaiTopBar">
        <!-- The centred title. -->
        <attr name="sancaiTitle" />
        <!-- Icon of the navigation button at the start; without it the bar has none. -->
        <attr name="sancaiIcon" />
        <!-- A quiet second line under the title. -->
        <attr name="sancaiTopBarSubtitle" format="string" />
        <!-- What the navigation button says to a screen reader (default: "Back"). -->
        <attr name="sancaiTopBarNavigationDescription" format="string" />
        <!-- Whether the hairline along the bottom edge is shown from the start. -->
        <attr name="sancaiTopBarLifted" format="boolean" />
        <!--
            Whether the bar pads itself for the status bar and display cutout (default true).
            Switch it off inside a host that already handles those insets.
        -->
        <attr name="sancaiTopBarFitStatusBar" format="boolean" />
    </declare-styleable>
</resources>
