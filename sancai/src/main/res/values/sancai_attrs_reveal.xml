<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SancaiRevealLayout">
        <!-- The edge at which the action strip is uncovered. Mirrored in RTL. -->
        <attr name="sancaiRevealEdge" format="enum">
            <enum name="start" value="0" />
            <enum name="end" value="1" />
        </attr>
        <!-- The label of the action behind the row. Without it the row does not move. -->
        <attr name="sancaiRevealActionLabel" format="string" />
        <!-- The tone that colours the bed. Default: danger. -->
        <attr name="sancaiRevealActionTone" format="enum">
            <enum name="ink" value="0" />
            <enum name="muted" value="1" />
            <enum name="accent" value="2" />
            <enum name="danger" value="3" />
            <enum name="warning" value="4" />
            <enum name="success" value="5" />
        </attr>
        <!-- Ordinal of the SancaiIcon drawn above the label; -1 (default) for none. -->
        <attr name="sancaiRevealActionIcon" format="integer" />
        <!-- Whether opening this row closes the other open rows of the same parent. Default: true. -->
        <attr name="sancaiRevealCloseSiblings" format="boolean" />
    </declare-styleable>
</resources>
