<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SancaiProgressBar">
        <!-- The glaze of the fill. Default cobalt. -->
        <attr name="sancaiGlaze" />
        <!-- Initial progress, from 0 to 1. -->
        <attr name="sancaiProgressValue" format="float" />
        <!-- True when the amount of work is unknown: a glazed segment travels through the groove. -->
        <attr name="sancaiProgressIndeterminate" format="boolean" />
        <attr name="android:enabled" />
    </declare-styleable>

    <declare-styleable name="SancaiSpinner">
        <!-- The tone of the ring. Default muted. -->
        <attr name="sancaiTone" />
        <!-- An explicit ring colour; wins over sancaiTone. -->
        <attr name="sancaiProgressSpinnerColor" format="color" />
        <attr name="android:enabled" />
    </declare-styleable>
</resources>
