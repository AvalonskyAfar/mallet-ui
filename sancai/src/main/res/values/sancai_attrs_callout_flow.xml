<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SancaiCallout">
        <!-- The title of the note, in the tone colour. -->
        <attr name="sancaiTitle" />
        <!-- The body of the note, in ink. -->
        <attr name="sancaiDetail" />
        <!-- Colour of the bar and the title: accent (default), danger, warning or success. -->
        <attr name="sancaiTone" />
    </declare-styleable>

    <declare-styleable name="SancaiFlowRow">
        <!-- Titles of the steps, in order, as a string array. -->
        <attr name="sancaiFlowRowTitles" format="reference" />
        <!-- Details of the steps, as a string array parallel to the titles. May be shorter or absent. -->
        <attr name="sancaiFlowRowDetails" format="reference" />
    </declare-styleable>
</resources>
