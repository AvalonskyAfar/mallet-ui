<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SancaiToastView: the pill of a SancaiToast. -->
    <declare-styleable name="SancaiToastView">
        <!-- The one thing the pill says. -->
        <attr name="sancaiToastMessage" format="string" />
        <!-- Colour of the pill: porcelain, or glazed in the danger or success colour. -->
        <attr name="sancaiToastTone" format="enum">
            <enum name="neutral" value="0" />
            <enum name="danger" value="1" />
            <enum name="success" value="2" />
        </attr>
        <!-- Label of the optional text action at the end of the pill. -->
        <attr name="sancaiToastActionLabel" format="string" />
    </declare-styleable>
</resources>
