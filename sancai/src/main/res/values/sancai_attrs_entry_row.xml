<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SancaiEntryRow: a row of a card that leads somewhere. -->
    <declare-styleable name="SancaiEntryRow">
        <attr name="android:enabled" />
        <attr name="sancaiTitle" />
        <attr name="sancaiDetail" />
        <!-- Icon at the start of the row. -->
        <attr name="sancaiIcon" />
        <!-- Chevron at the edge of the row. -->
        <attr name="sancaiEntryArrow" format="enum">
            <enum name="none" value="0" />
            <enum name="end" value="1" />
            <enum name="start" value="2" />
        </attr>
        <!-- Whether the text is centred in the row or aligned to its start. -->
        <attr name="sancaiEntryAlignment" format="enum">
            <enum name="center" value="0" />
            <enum name="start" value="1" />
        </attr>
        <!-- Short value shown at the end of the row, before the end chevron. -->
        <attr name="sancaiEntryValue" format="string" />
    </declare-styleable>
</resources>
