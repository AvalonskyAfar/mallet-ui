<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SancaiRadioButton">
        <!-- Whether the radio starts checked. Inside a SancaiRadioGroup the last checked child wins. -->
        <attr name="sancaiChecked" />
        <!-- Glaze poured into the bed when the radio is checked. Cobalt by default. -->
        <attr name="sancaiGlaze" />
        <!-- Label drawn to the end of the bed. -->
        <attr name="android:text" />
        <attr name="android:enabled" />
    </declare-styleable>

    <declare-styleable name="SancaiRadioGroup">
        <!-- Id of the child radio that is checked at start. -->
        <attr name="sancaiRadioCheckedButton" format="reference" />
    </declare-styleable>
</resources>
