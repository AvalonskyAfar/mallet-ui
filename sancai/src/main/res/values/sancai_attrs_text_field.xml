<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Label written above the well. -->
    <attr name="sancaiFieldLabel" format="string" />
    <!-- Helper text written below the well. -->
    <attr name="sancaiFieldHelper" format="string" />
    <!-- Error written below the well in place of the helper; also colours the rim. -->
    <attr name="sancaiFieldError" format="string" />
    <!-- Maximum length shown by the character counter; 0 hides the counter. -->
    <attr name="sancaiFieldCounter" format="integer" />
    <!-- Several lines instead of one. -->
    <attr name="sancaiFieldMultiline" format="boolean" />
    <!-- Action drawn inside the well at the end. -->
    <attr name="sancaiFieldEndAction" format="enum">
        <enum name="none" value="0" />
        <enum name="clear" value="1" />
        <enum name="passwordToggle" value="2" />
    </attr>
    <!-- Monospace type, for code and configuration editors. -->
    <attr name="sancaiFieldMonospace" format="boolean" />

    <!-- Id of the EditText inside a SancaiTextField. -->
    <item name="sancai_text_field_edit" type="id" />

    <declare-styleable name="SancaiTextField">
        <attr name="android:enabled" />
        <attr name="android:text" />
        <attr name="android:hint" />
        <attr name="android:inputType" />
        <attr name="android:maxLength" />
        <attr name="android:minLines" />
        <attr name="android:maxLines" />
        <attr name="sancaiIcon" />
        <attr name="sancaiFieldLabel" />
        <attr name="sancaiFieldHelper" />
        <attr name="sancaiFieldError" />
        <attr name="sancaiFieldCounter" />
        <attr name="sancaiFieldMultiline" />
        <attr name="sancaiFieldEndAction" />
        <attr name="sancaiFieldMonospace" />
    </declare-styleable>
</resources>
