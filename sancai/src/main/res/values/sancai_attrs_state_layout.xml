<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SancaiStateLayout">
        <!-- The state shown first. Default content. -->
        <attr name="sancaiStateLayoutState" format="enum">
            <enum name="content" value="0" />
            <enum name="loading" value="1" />
            <enum name="empty" value="2" />
            <enum name="error" value="3" />
        </attr>
        <!-- Shortest time the loading state stays on screen, in milliseconds. Default 400. -->
        <attr name="sancaiStateLayoutMinimumLoadingMs" format="integer" />
        <!-- The caption under the spinner. Default "Loading". -->
        <attr name="sancaiStateLayoutLoadingLabel" format="string" />
        <!-- Title of the default empty message. -->
        <attr name="sancaiStateLayoutEmptyTitle" format="string" />
        <!-- Supporting sentence of the default empty message. -->
        <attr name="sancaiStateLayoutEmptyDetail" format="string" />
        <!-- Title of the default error message. -->
        <attr name="sancaiStateLayoutErrorTitle" format="string" />
        <!-- Supporting sentence of the default error message. -->
        <attr name="sancaiStateLayoutErrorDetail" format="string" />
        <attr name="android:enabled" />
    </declare-styleable>
</resources>
