<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SancaiStateView">
        <!-- The title, one short phrase. -->
        <attr name="sancaiTitle" />
        <!-- The supporting sentence under the title. -->
        <attr name="sancaiDetail" />
        <!-- Overrides the icon of the kind; "none" removes the icon. -->
        <attr name="sancaiIcon" />
        <!-- The preset of icon and icon colour. Default empty. -->
        <attr name="sancaiStateViewKind" format="enum">
            <enum name="empty" value="0" />
            <enum name="error" value="1" />
            <enum name="offline" value="2" />
            <enum name="success" value="3" />
            <enum name="info" value="4" />
        </attr>
        <!-- Label of the action button; without it there is no button. -->
        <attr name="sancaiStateViewAction" format="string" />
        <!-- The small form for a card row: 28dp icon and tighter gaps. -->
        <attr name="sancaiStateViewCompact" format="boolean" />
        <attr name="android:enabled" />
    </declare-styleable>
</resources>
