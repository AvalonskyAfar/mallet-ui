<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Number of digits written after the decimal separator. -->
    <attr name="sancaiStepperDecimals" format="integer" />
    <!-- Suffix written after the value, for example "ms" or "%". -->
    <attr name="sancaiStepperUnit" format="string" />

    <!-- Id of the custom accessibility action that requests editing. -->
    <item name="sancai_stepper_action_edit" type="id" />

    <declare-styleable name="SancaiStepper">
        <attr name="android:enabled" />
        <attr name="sancaiGlaze" />
        <attr name="sancaiValueFrom" />
        <attr name="sancaiValueTo" />
        <attr name="sancaiStepSize" />
        <attr name="sancaiValue" />
        <attr name="sancaiStepperDecimals" />
        <attr name="sancaiStepperUnit" />
    </declare-styleable>
</resources>
