<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SancaiFloatingPanel: a draggable porcelain panel. -->
    <declare-styleable name="SancaiFloatingPanel">
        <!-- Start position as a fraction of the free travel: 0 start edge, 1 end edge. -->
        <attr name="sancaiFloatingPanelPositionX" format="float" />
        <!-- Start position as a fraction of the free travel: 0 top, 1 bottom. -->
        <attr name="sancaiFloatingPanelPositionY" format="float" />
        <!-- Glide to the nearer side of the parent when a drag ends. Default false. -->
        <attr name="sancaiFloatingPanelSnapToEdge" format="boolean" />
    </declare-styleable>

    <!-- Id of the panel added by SancaiFloatingPanel.attach(), so its position is saved. -->
    <item name="sancai_floating_panel" type="id" />
</resources>
