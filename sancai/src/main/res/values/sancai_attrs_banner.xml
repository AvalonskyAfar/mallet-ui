<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SancaiBanner">
        <attr name="sancaiTitle" />
        <attr name="sancaiDetail" />
        <!-- Replaces the icon the tone brings. -->
        <attr name="sancaiIcon" />
        <!-- What kind of condition the banner reports. -->
        <attr name="sancaiBannerTone" format="enum">
            <enum name="info" value="0" />
            <enum name="warning" value="1" />
            <enum name="danger" value="2" />
            <enum name="success" value="3" />
        </attr>
        <!-- Label of the main text action, at the very end. -->
        <attr name="sancaiBannerAction" format="string" />
        <!-- Label of the second text action, before the main one. -->
        <attr name="sancaiBannerSecondaryAction" format="string" />
        <!-- Shows the close icon. -->
        <attr name="sancaiBannerDismissible" format="boolean" />
        <!-- Hides the tone icon when false. -->
        <attr name="sancaiBannerShowIcon" format="boolean" />
        <!-- Whether the banner starts out shown (default) or collapsed. -->
        <attr name="sancaiBannerShown" format="boolean" />
    </declare-styleable>
</resources>
